{
  "$schema": "https://embarko.ai/schema/embarko.json",
  "appId": "cmw8w6mdt0uga7cvpw6kwb1h7",
  "schedules": [
    {
      "cron": "*/5 * * * *",
      "path": "/api/internal/cron/tick",
      "timezone": "Asia/Kolkata",
      "name": "KONVO tick: phone answers, M91 invitations, sync retries"
    },
    { "cron": "5 * * * *", "path": "/api/internal/cron/hourly", "timezone": "Asia/Kolkata", "name": "KONVO hourly: reminders, escalations, daily reports" },
    { "cron": "0 2 * * *", "path": "/api/internal/cron/nightly", "timezone": "Asia/Kolkata", "name": "KONVO nightly: performance snapshots" },
    { "cron": "0 8 * * 1", "path": "/api/internal/cron/weekly", "timezone": "Asia/Kolkata", "name": "KONVO weekly team reports" }
  ]
}

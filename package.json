{
  "name": "konvo",
  "version": "0.1.0",
  "private": true,
  "description": "KONVO: AI work intelligence platform. From conversations to contribution.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "packages/shared",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w @workpulse/shared && npm run build -w @workpulse/api && npm run build -w @workpulse/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "db:migrate": "npm run db:migrate -w @workpulse/api",
    "db:seed": "npm run db:seed -w @workpulse/api",
    "start": "npm run start -w @workpulse/api",
    "db:deploy": "npm run db:deploy -w @workpulse/api",
    "viasocket:selftest": "npm run viasocket:selftest -w @workpulse/api",
    "dev:no-tunnel": "concurrently -k -n api,web -c blue,green \"npm run dev -w @workpulse/api\" \"npm run dev -w @workpulse/web\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.65.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "prettier": "3.10.1",
    "typescript-eslint": "^8.72.2"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
    "msgpackr-extract@3.0.7": true
  },
  "dependencies": {
    "typescript": "~6.0.3"
  }
}

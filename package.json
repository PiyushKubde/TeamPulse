{
  "name": "teampulse",
  "version": "0.1.0",
  "private": true,
  "description": "KONVO - AI Work Intelligence Platform. From conversations to contribution.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --watch server/index.js",
    "migrate": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/migrate.js",
    "seed:demo": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/seed-demo.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.js\"",
    "lint": "eslint .",
    "check": "node --check server/index.js && npm run lint",
    "test:e2e": "node --disable-warning=ExperimentalWarning scripts/e2e.mjs",
    "test:e2e:auth": "node --disable-warning=ExperimentalWarning scripts/e2e-auth.mjs",
    "test:e2e:measurement": "node --disable-warning=ExperimentalWarning scripts/e2e-measurement.mjs",
    "eval:measurement": "node --disable-warning=ExperimentalWarning scripts/eval-measurement.mjs",
    "test:e2e:evidence": "node --disable-warning=ExperimentalWarning scripts/e2e-evidence.mjs",
    "test:e2e:manager": "node --disable-warning=ExperimentalWarning scripts/e2e-manager.mjs",
    "test:e2e:slack": "node --disable-warning=ExperimentalWarning scripts/e2e-slack.mjs",
    "test:e2e:navigation": "node --disable-warning=ExperimentalWarning scripts/e2e-navigation.mjs",
    "test:e2e:workboard": "node --disable-warning=ExperimentalWarning scripts/e2e-workboard.mjs",
    "test:e2e:intelligence": "node --disable-warning=ExperimentalWarning scripts/e2e-work-intelligence.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "express": "^5.3.0",
    "hash-wasm": "4.13.0",
    "nodemailer": "10.4.0",
    "viasocket-apps": "0.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^16.5.0"
  }
}

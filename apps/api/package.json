{
  "name": "@workpulse/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "worker:dev": "tsx watch --env-file-if-exists=../../.env src/worker.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "start:worker": "node --env-file-if-exists=../../.env dist/worker.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate",
    "start:e2e": "tsx --env-file-if-exists=../../.env src/server.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/s3-request-presigner": "^3.1169.0",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@workpulse/shared": "*",
    "bullmq": "^6.7.6",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "multer": "^2.5.0",
    "nodemailer": "^7.0.10",
    "openai": "^7.57.0",
    "pdfkit": "^0.17.2",
    "pino": "^10.4.0",
    "viasocket-apps": "0.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^7.0.4",
    "@types/pdfkit": "^0.17.3",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.1.2",
    "prisma": "7.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}

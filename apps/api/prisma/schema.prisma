// WorkPulse data model. Every tenant-owned row carries orgId; queries go through scoped helpers (src/lib/scope.ts).
generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

// ───────────── Identity & tenancy ─────────────

enum Role {
  OWNER
  ADMIN
  MANAGER
  MENTOR
  MEMBER
}

enum MemberStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  name            String
  passwordHash    String?
  emailVerifiedAt DateTime?
  timezone        String    @default("UTC")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions        Session[]
  authTokens      AuthToken[]
  memberships     OrganizationMember[]
  teamMembers     TeamMember[]
  managedTeams    Team[]               @relation("TeamManager")
  mentorOf        MentorAssignment[]   @relation("Mentor")
  menteeOf        MentorAssignment[]   @relation("Mentee")
  assignedTasks   Task[]               @relation("TaskAssignee")
  createdTasks    Task[]               @relation("TaskCreator")
  ownedProjects   Project[]
  ownedGoals      Goal[]
  workSessions    WorkSession[]
  dailyPlans      DailyPlan[]
  notifications   Notification[]
  connections     IntegrationConnection[]
}

model Session {
  id          String   @id @default(uuid())
  userId      String
  tokenHash   String   @unique
  activeOrgId String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum AuthTokenKind {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model AuthToken {
  id        String        @id @default(uuid())
  userId    String
  kind      AuthTokenKind
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  /// { retentionDays, requireReportApproval, workWeek }
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members       OrganizationMember[]
  invitations   Invitation[]
  teams         Team[]
  mentorships   MentorAssignment[]
  projects      Project[]
  goals         Goal[]
  tasks         Task[]
  taskSources   TaskSource[]
  templates     TaskTemplate[]
  workSessions  WorkSession[]
  dailyPlans    DailyPlan[]
  blockers      Blocker[]
  evidence      Evidence[]
  connections   IntegrationConnection[]
  syncEvents    SyncEvent[]
  syncMappings  SyncMapping[]
  scoringModels ScoringModel[]
  snapshots     PerformanceSnapshot[]
  assessments   QualityAssessment[]
  reports       Report[]
  feedback      Feedback[]
  corrections   CorrectionRequest[]
  notifications Notification[]
  automations   AutomationExecution[]
  auditLogs     AuditLog[]
}

model OrganizationMember {
  id        String       @id @default(uuid())
  orgId     String
  userId    String
  role      Role         @default(MEMBER)
  title     String?
  status    MemberStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
}

model Invitation {
  id         String       @id @default(uuid())
  orgId      String
  email      String
  role       Role         @default(MEMBER)
  teamId     String?
  invitedBy  String
  tokenHash  String       @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime     @default(now())
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, email])
}

model Team {
  id        String       @id @default(uuid())
  orgId     String
  name      String
  managerId String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  manager   User?        @relation("TeamManager", fields: [managerId], references: [id], onDelete: SetNull)
  members   TeamMember[]
  projects  Project[]
  goals     Goal[]

  @@unique([orgId, name])
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  userId    String
  createdAt DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

model MentorAssignment {
  id        String       @id @default(uuid())
  orgId     String
  mentorId  String
  menteeId  String
  createdAt DateTime     @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  mentor    User         @relation("Mentor", fields: [mentorId], references: [id], onDelete: Cascade)
  mentee    User         @relation("Mentee", fields: [menteeId], references: [id], onDelete: Cascade)

  @@unique([orgId, mentorId, menteeId])
}

// ───────────── Work ─────────────

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

model Project {
  id          String        @id @default(uuid())
  orgId       String
  teamId      String?
  ownerId     String
  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)
  startDate   DateTime?
  targetDate  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  org         Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  team        Team?         @relation(fields: [teamId], references: [id], onDelete: SetNull)
  owner       User          @relation(fields: [ownerId], references: [id])
  tasks       Task[]

  @@index([orgId, status])
}

enum GoalPeriod {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  MILESTONE
}

enum GoalStatus {
  ON_TRACK
  AT_RISK
  OFF_TRACK
  ACHIEVED
  MISSED
  CANCELLED
}

model Goal {
  id              String       @id @default(uuid())
  orgId           String
  ownerId         String
  teamId          String?
  parentId        String?
  period          GoalPeriod
  title           String
  description     String?
  expectedOutcome String?
  actualOutcome   String?
  /// 0-100. Derived from key results when any exist, otherwise set by the owner.
  progress        Int          @default(0)
  status          GoalStatus   @default(ON_TRACK)
  startDate       DateTime
  dueDate         DateTime
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  owner           User         @relation(fields: [ownerId], references: [id])
  team            Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  parent          Goal?        @relation("GoalTree", fields: [parentId], references: [id], onDelete: SetNull)
  children        Goal[]       @relation("GoalTree")
  keyResults      KeyResult[]
  updates         GoalUpdate[]
  tasks           TaskGoal[]

  @@index([orgId, period, ownerId])
}

model KeyResult {
  id        String   @id @default(uuid())
  goalId    String
  title     String
  unit      String?
  start     Float    @default(0)
  target    Float
  current   Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
}

model GoalUpdate {
  id        String   @id @default(uuid())
  goalId    String
  authorId  String
  progress  Int
  status    GoalStatus
  note      String?
  createdAt DateTime @default(now())
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, createdAt])
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  BLOCKED
  COMPLETED
  CANCELLED
}

enum Priority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum ImpactLevel {
  NONE
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskOrigin {
  NATIVE
  EXTERNAL
}

model Task {
  id             String       @id @default(uuid())
  orgId          String
  projectId      String?
  parentId       String?
  title          String
  description    String?
  status         TaskStatus   @default(TODO)
  priority       Priority     @default(MEDIUM)
  category       String?
  labels         String[]     @default([])
  assigneeId     String?
  creatorId      String
  dueAt          DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  estimateMins   Int?
  actualMins     Int          @default(0)
  /// Internal-only. Never written by external sync.
  impactLevel    ImpactLevel  @default(NONE)
  /// 1-5. Internal-only.
  complexity     Int          @default(2)
  recurrenceRule String?
  reopenCount    Int          @default(0)
  origin         TaskOrigin   @default(NATIVE)
  /// Set when sync could not map a value and a person should look.
  needsReview    Boolean      @default(false)
  sortOrder      Float        @default(0)
  archivedAt     DateTime?
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parent         Task?        @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks       Task[]       @relation("Subtasks")
  assignee       User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator        User         @relation("TaskCreator", fields: [creatorId], references: [id])
  source         TaskSource?
  goals          TaskGoal[]
  dependsOn      TaskDependency[] @relation("DependentTask")
  blocking       TaskDependency[] @relation("BlockingTask")
  comments       TaskComment[]
  activity       TaskActivity[]
  attachments    Attachment[]
  evidence       Evidence[]
  blockers       Blocker[]
  workSessions   WorkSession[]
  assessments    QualityAssessment[]
  conflicts      SyncConflict[]

  @@index([orgId, assigneeId, status])
  @@index([orgId, dueAt])
  @@index([orgId, projectId])
  @@index([orgId, completedAt])
  @@index([parentId])
}

model TaskGoal {
  taskId       String
  goalId       String
  /// Relative contribution weight of this task to the goal, 1-5.
  contribution Int    @default(1)
  task         Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  goal         Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@id([taskId, goalId])
  @@index([goalId])
}

model TaskDependency {
  taskId      String
  dependsOnId String
  task        Task   @relation("DependentTask", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn   Task   @relation("BlockingTask", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@id([taskId, dependsOnId])
}

model TaskComment {
  id         String    @id @default(uuid())
  taskId     String
  authorId   String?
  /// Set for comments imported from a provider.
  externalId String?
  body       String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  task       Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, externalId])
  @@index([taskId, createdAt])
}

enum Actor {
  USER
  SYNC
  AI
  SYSTEM
}

model TaskActivity {
  id        String   @id @default(uuid())
  taskId    String
  actorType Actor    @default(USER)
  actorId   String?
  kind      String
  field     String?
  fromValue String?
  toValue   String?
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model Attachment {
  id          String   @id @default(uuid())
  orgId       String
  taskId      String
  uploadedBy  String
  fileName    String
  mimeType    String
  sizeBytes   Int
  storageKey  String   @unique
  createdAt   DateTime @default(now())
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model TaskTemplate {
  id        String       @id @default(uuid())
  orgId     String
  name      String
  /// Allowed task fields only (validated with the shared zod schema).
  fields    Json
  createdBy String
  createdAt DateTime     @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, name])
}

model TaskSource {
  id                String       @id @default(uuid())
  orgId             String
  taskId            String       @unique
  provider          String
  externalId        String
  externalKey       String?
  sourceUrl         String?
  connectionId      String?
  externalUpdatedAt DateTime?
  externalRevision  String?
  lastSyncedAt      DateTime     @default(now())
  /// Last normalized external values, used for two-way conflict detection.
  lastExternal      Json         @default("{}")
  rawSnapshot       Json         @default("{}")
  org               Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  task              Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  connection        IntegrationConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@unique([orgId, provider, externalId])
}

enum WorkSessionKind {
  FOCUS
  MANUAL
}

model WorkSession {
  id        String          @id @default(uuid())
  orgId     String
  userId    String
  taskId    String?
  kind      WorkSessionKind @default(FOCUS)
  startedAt DateTime
  endedAt   DateTime?
  note      String?
  org       Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  task      Task?           @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([orgId, userId, startedAt])
}

model DailyPlan {
  id           String       @id @default(uuid())
  orgId        String
  userId       String
  /// The user's calendar date, YYYY-MM-DD.
  date         String
  /// [{ text, taskId? , done }] max 3
  topOutcomes  Json         @default("[]")
  plannedTaskIds String[]   @default([])
  checkIn      String?
  energy       Int?
  review       String?
  /// [{ taskId, reason }]
  carryForward Json         @default("[]")
  reviewedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId, date])
}

enum BlockerKind {
  INTERNAL
  EXTERNAL
  DEPENDENCY
}

model Blocker {
  id           String       @id @default(uuid())
  orgId        String
  taskId       String
  reportedById String
  kind         BlockerKind  @default(INTERNAL)
  reason       String
  resolvedAt   DateTime?
  resolution   String?
  createdAt    DateTime     @default(now())
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  task         Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([orgId, resolvedAt])
  @@index([taskId])
}

// ───────────── Evidence ─────────────

enum EvidenceKind {
  COMMIT
  PULL_REQUEST
  RELEASE
  ISSUE_LINK
  DOCUMENT
  REPORT
  DEPLOYMENT
  SCREENSHOT
  FILE
  APPROVAL
  URL
}

enum EvidenceSource {
  MANUAL
  GITHUB
  LINEAR
  JIRA
  UPLOAD
}

enum VerificationStatus {
  RECEIVED
  VERIFIED
  REJECTED
}

model Evidence {
  id           String             @id @default(uuid())
  orgId        String
  /// Null while a GitHub item waits to be matched to a task.
  taskId       String?
  kind         EvidenceKind
  source       EvidenceSource     @default(MANUAL)
  title        String
  url          String?
  storageKey   String?
  mimeType     String?
  sizeBytes    Int?
  externalId   String?
  sourceMeta   Json               @default("{}")
  aiSummary    String?
  /// Suggested task match for unmatched provider evidence (AI or rule), never applied automatically.
  suggestedTaskId String?
  matchConfidence Float?
  status       VerificationStatus @default(RECEIVED)
  addedById    String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  deletedAt    DateTime?
  org          Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  task         Task?              @relation(fields: [taskId], references: [id], onDelete: SetNull)
  verifications EvidenceVerification[]

  @@unique([orgId, source, externalId])
  @@index([orgId, taskId])
  @@index([orgId, status])
}

model EvidenceVerification {
  id           String             @id @default(uuid())
  evidenceId   String
  verifierId   String
  status       VerificationStatus
  /// 1-5 quality of the work this evidence shows; separate from business impact.
  qualityScore Int?
  impactNote   String?
  note         String?
  createdAt    DateTime           @default(now())
  evidence     Evidence           @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@index([evidenceId])
}

// ───────────── Integrations ─────────────

enum ConnectionStatus {
  ACTIVE
  EXPIRED
  REVOKED
  ERROR
}

enum SyncMode {
  IMPORT_ONLY
  ONE_WAY
  TWO_WAY
}

model IntegrationConnection {
  id          String           @id @default(uuid())
  orgId       String
  userId      String
  provider    String
  /// AES-256-GCM ciphertext of the viaSocket auth_id.
  authIdEnc   String
  authIdHash  String
  label       String?
  status      ConnectionStatus @default(ACTIVE)
  syncMode    SyncMode         @default(ONE_WAY)
  /// Choices made once after Connect: { teamId, teamName, projectKey, repos[], channel, statusMap, userMap }
  settings    Json             @default("{}")
  /// AES-256-GCM ciphertext of the enabled-app script_id, when the app is enabled for actions.
  enabledScriptIdEnc String?
  lastError   String?
  lastSyncAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  org         Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptions IntegrationSubscription[]
  checkpoints SyncCheckpoint[]
  taskSources TaskSource[]

  @@unique([userId, provider, authIdHash])
  @@index([orgId, provider])
}

model IntegrationSubscription {
  id            String                @id @default(uuid())
  connectionId  String
  triggerKey    String
  /// The repo / team / project this subscription watches.
  resource      String                @default("")
  version       String
  /// AES-256-GCM ciphertext of the subscription script_id.
  scriptIdEnc   String?
  inputData     Json
  /// sha256 of the handler string sent to viaSocket (the handler embeds a secret, so it is not stored).
  handlerHash   String?
  /// The PUBLIC_API_URL the handler posts to; when it changes (a new tunnel), handlers are re-pointed on start-up.
  handlerBase   String?
  /// sha256 of the bearer token the handler presents to /api/integrations/events.
  tokenHash     String                @unique
  status        String                @default("ACTIVE")
  lastEventAt   DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  connection    IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  events        SyncEvent[]

  @@unique([connectionId, triggerKey, resource])
}

enum SyncEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  SKIPPED_STALE
  SKIPPED_DUPLICATE
  NEEDS_MAPPING
  FAILED
  DEAD
}

model SyncEvent {
  id             String          @id @default(uuid())
  orgId          String
  subscriptionId String?
  connectionId   String?
  provider       String
  eventType      String
  idempotencyKey String
  payload        Json
  status         SyncEventStatus @default(RECEIVED)
  attempts       Int             @default(0)
  error          String?
  taskId         String?
  receivedAt     DateTime        @default(now())
  processedAt    DateTime?
  org            Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  subscription   IntegrationSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@unique([orgId, provider, idempotencyKey])
  @@index([orgId, status, receivedAt])
  @@index([connectionId, receivedAt])
}

enum MappingKind {
  STATUS
  PRIORITY
  FIELD
}

enum MappingSource {
  DEFAULT
  USER
  AI
}

model SyncMapping {
  id           String        @id @default(uuid())
  orgId        String
  provider     String
  kind         MappingKind
  fromValue    String
  toValue      String
  confidence   Float         @default(1)
  source       MappingSource @default(USER)
  version      Int           @default(1)
  active       Boolean       @default(false)
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime      @default(now())
  org          Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, provider, kind, fromValue, version])
  @@index([orgId, provider, active])
}

model SyncCheckpoint {
  id           String                @id @default(uuid())
  connectionId String
  resource     String
  cursor       String?
  lastRunAt    DateTime?
  connection   IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, resource])
}

model SyncConflict {
  id            String    @id @default(uuid())
  taskId        String
  field         String
  internalValue String?
  externalValue String?
  resolution    String?
  resolvedById  String?
  resolvedAt    DateTime?
  createdAt     DateTime  @default(now())
  task          Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, resolvedAt])
}

// ───────────── Performance ─────────────

model ScoringModel {
  id        String       @id @default(uuid())
  orgId     String
  name      String
  /// Applies to members with this role; null = default model.
  role      Role?
  version   Int          @default(1)
  /// { impact, quality, alignment, reliability, evidence } summing to 100
  weights   Json
  active    Boolean      @default(true)
  createdBy String?
  createdAt DateTime     @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  snapshots PerformanceSnapshot[]

  @@unique([orgId, name, version])
}

enum Granularity {
  DAY
  WEEK
  MONTH
}

model PerformanceSnapshot {
  id             String       @id @default(uuid())
  orgId          String
  /// "user:<id>" or "team:<id>" or "org"
  subject        String
  periodStart    DateTime
  periodEnd      DateTime
  granularity    Granularity
  scoringModelId String
  /// Score 0-100, null when no dimension had data.
  score          Float?
  /// Per dimension: { value, weight, inputs, missing[] } plus diagnostics.
  components     Json
  metrics        Json
  calculatedAt   DateTime     @default(now())
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  scoringModel   ScoringModel @relation(fields: [scoringModelId], references: [id], onDelete: Cascade)

  @@unique([orgId, subject, granularity, periodStart, scoringModelId])
  @@index([orgId, subject, periodStart])
}

model QualityAssessment {
  id         String       @id @default(uuid())
  orgId      String
  taskId     String
  assessorId String
  /// 1-5
  quality    Int
  /// Business impact as judged by a person; separate from the task's planned impactLevel.
  impact     ImpactLevel?
  note       String?
  createdAt  DateTime     @default(now())
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  task       Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, assessorId])
}

// ───────────── Reports, feedback, notifications ─────────────

enum ReportKind {
  DAILY
  WEEKLY
}

model Report {
  id            String       @id @default(uuid())
  orgId         String
  kind          ReportKind
  /// "user:<id>" or "team:<id>"
  subject       String
  periodStart   DateTime
  periodEnd     DateTime
  content       Json
  aiSummary     String?
  generatedById String?
  createdAt     DateTime     @default(now())
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  deliveries    ReportDelivery[]

  @@unique([orgId, kind, subject, periodStart])
}

model ReportDelivery {
  id        String   @id @default(uuid())
  reportId  String
  channel   String
  target    String
  status    String
  error     String?
  createdAt DateTime @default(now())
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

enum FeedbackKind {
  MANAGER
  MENTOR
  SELF
  PEER
}

model Feedback {
  id             String       @id @default(uuid())
  orgId          String
  subjectUserId  String
  authorId       String
  kind           FeedbackKind
  body           String
  /// Optional 1-5
  rating         Int?
  taskId         String?
  periodLabel    String?
  acknowledgedAt DateTime?
  response       String?
  createdAt      DateTime     @default(now())
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, subjectUserId, createdAt])
}

enum CorrectionStatus {
  OPEN
  ACCEPTED
  REJECTED
}

model CorrectionRequest {
  id           String           @id @default(uuid())
  orgId        String
  requesterId  String
  /// TASK | SNAPSHOT | ASSESSMENT | FEEDBACK | EVIDENCE
  targetType   String
  targetId     String
  field        String?
  reason       String
  status       CorrectionStatus @default(OPEN)
  resolvedById String?
  resolution   String?
  createdAt    DateTime         @default(now())
  resolvedAt   DateTime?
  org          Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, status])
}

model Notification {
  id        String       @id @default(uuid())
  orgId     String
  userId    String
  kind      String
  title     String
  body      String?
  link      String?
  dedupeKey String       @unique
  readAt    DateTime?
  createdAt DateTime     @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model AutomationExecution {
  id         String       @id @default(uuid())
  orgId      String
  userId     String?
  automation String
  status     String
  attempts   Int          @default(0)
  error      String?
  detail     Json         @default("{}")
  dedupeKey  String       @unique
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, automation, createdAt])
}

model AuditLog {
  id         String       @id @default(uuid())
  orgId      String
  actorId    String?
  action     String
  targetType String
  targetId   String?
  diff       Json         @default("{}")
  ip         String?
  createdAt  DateTime     @default(now())
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
}

# TeamPulse configuration. Copy to .env for local development; on Embarko set these in the app's
# App setup / Environment page. Never commit real values.

# --- Server ---
# PORT, DATA_DIR, APP_NAME and CRON_SECRET are set by Embarko automatically. Locally the app uses
# PORT=3000 and ./data, and listens on 127.0.0.1 only.
PORT=3000
# Public HTTPS address of the app, without a trailing slash. Used in invitation links and notification messages.
APP_URL=http://localhost:3000
# NODE_ENV=production

# --- Google sign-in (OAuth 2.0 / OpenID Connect) ---
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" of the OAuth client:
#   local:   http://localhost:3000/auth/google/callback
#   Embarko: https://<app-name>.embarko.app/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Set to "false" to stop signed-in users from creating new organizations (then only invitations/join codes work).
ALLOW_ORG_CREATION=true
SESSION_DAYS=14

# --- Email and password sign-in — optional; without a provider only Google sign-in is offered ---
# Verification and password-reset emails need a real provider. Pick ONE:
#   smtp            any SMTP service: Postmark, Amazon SES, Resend, SendGrid, Brevo, Mailgun, MSG91 Email,
#                   or a Google Workspace / Gmail account with an app password.
#   viasocket_gmail a Gmail account connected in TeamPulse's Automation Center (needs the ViaSocket keys below).
# Leave MAIL_PROVIDER empty to keep email sign-up and password reset switched off (they say "not available").
MAIL_PROVIDER=
# Sender address. It must be verified with your provider (domain with SPF/DKIM, or a verified single sender).
MAIL_FROM=
MAIL_FROM_NAME=TeamPulse
# For MAIL_PROVIDER=smtp. Port 587 uses STARTTLS (SMTP_SECURE=false); port 465 uses TLS (SMTP_SECURE=true).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# For MAIL_PROVIDER=viasocket_gmail: the TeamPulse user id of an active member who connected Gmail, and that connection's id.
MAIL_VIASOCKET_USER_ID=
MAIL_VIASOCKET_CONNECTION_ID=
# Optional links shown next to the "I agree" checkbox on the sign-up page.
TERMS_URL=
PRIVACY_URL=

# --- AI work measurement — optional; without it the app says AI analysis is not set up ---
# anthropic = real analysis (key stays on the server). mock = SIMULATED analyser for local demos only (ignored in production).
AI_PROVIDER=
ANTHROPIC_API_KEY=
# Defaults: claude-opus-5-5, medium effort, 120 s timeout, server-side fallback on safety declines (AI_FALLBACKS=off to disable).
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
AI_TIMEOUT_MS=120000
AI_FALLBACKS=on
# off | supervised | on. Default with a real provider: supervised = only the tasks below, started by an admin,
# no automatic runs, no notifications. Use "on" only after the supervised validation (docs/supervised-ai-validation.md).
AI_MODE=supervised
# Comma-separated "taskId:owner-email" pairs selected for the supervised test (the email must match the task's owner).
AI_SUPERVISED_TASKS=

# --- Local development only ---
# DEV_LOGIN=1 shows a "sign in by email" form so you can try roles without Google.
# Ignored whenever NODE_ENV=production or the app runs on Embarko.
DEV_LOGIN=
# Runs the alert job every 5 minutes in-process (local only; Embarko uses embarko.json schedules).
LOCAL_SCHEDULER=
# Scheduled routes (/tasks/*) require "Authorization: Bearer $CRON_SECRET". Embarko sets it; set one locally to try them.
CRON_SECRET=

# --- ViaSocket (Automation Center) — optional; integrations stay disabled without them ---
# Get all three at https://flow.viasocket.com/embed-keys?name=TeamPulse (click Copy).
VIASOCKET_ORG_ID=
VIASOCKET_PROJECT_ID=
# Server only. Never in frontend code, screenshots or logs.
VIASOCKET_EMBED_SECRET=

# --- M91 alerts (MSG91) — optional; alerts are in-app until configured ---
# An API key from the M91 app (Settings → API keys), m91sk_…  — https://m91.msg91.com/docs/api
M91_API_KEY=
# Any random secret (openssl rand -hex 24). TeamPulse gives M91 the callback URL https://<app>/api/webhooks/m91?token=<this value> on each alert.
M91_CALLBACK_TOKEN=

# Max evidence upload size in bytes (default 5 MB).
UPLOAD_MAX_BYTES=5242880

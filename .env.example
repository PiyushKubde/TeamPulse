# WorkPulse configuration. Copy to .env for local development. Never commit .env.
# Every variable is read by apps/api/src/config/env.ts and validated at start-up.

# --- Server ---
NODE_ENV=development
PORT=4000
# Public URL of the web app (used in emails, invitations, links in Slack reports).
APP_URL=http://localhost:5173
# Public HTTPS URL at which viaSocket can reach the API's events endpoint
# (/api/integrations/events/...). Locally this needs a tunnel (e.g. `cloudflared tunnel --url http://localhost:4000`).
# Without it, Connect works but subscriptions to new/updated external tasks cannot be created.
PUBLIC_API_URL=
# Comma-separated browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# --- Data ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/workpulse
# Used by the API integration tests (vitest). It is reset by the test run.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/workpulse_test
REDIS_URL=redis://localhost:6379

# --- Security ---
# 32 random bytes, base64. Encrypts viaSocket auth_id / script_id values at rest.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=
SESSION_DAYS=14
# Set to "false" to allow sign-in before the email address is verified (development only).
REQUIRE_EMAIL_VERIFICATION=false

# --- Email (verification, password reset, invitations, emailed reports) ---
# Leave SMTP_HOST empty in development: emails are written to the API log instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=WorkPulse <no-reply@example.com>

# --- File storage (evidence and attachments): any S3-compatible service ---
# Leave S3_BUCKET empty in development: files are stored under ./data/uploads instead.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
UPLOAD_MAX_BYTES=10485760

# --- AI ---
# viasocket (default): OpenAI models through viaSocket's AI API, using the VIASOCKET_* keys below; no model key.
# openai: direct OpenAI API with OPENAI_API_KEY.
# Empty or missing credentials: every AI feature answers "AI is not configured"; the rest of the app works.
AI_PROVIDER=viasocket
AI_SERVICE=openai
# Model for structured tasks (classification, mapping suggestions, summaries).
AI_MODEL_FAST=gpt-6-luna
# Model for the assistant (tool use, reasoning).
AI_MODEL_ASSISTANT=gpt-6.1-terra
# Must be "true" before any work data is sent to an AI provider: confirm the provider's data-processing terms first.
AI_DATA_POLICY_CONFIRMED=false
OPENAI_API_KEY=

# --- viaSocket (integrations, report delivery, AI) ---
# Written by `npx -y viasocket-apps setup --no-open` (one click on Allow). Server only; never in frontend code or logs.
VIASOCKET_ORG_ID=
VIASOCKET_PROJECT_ID=
VIASOCKET_EMBED_SECRET=
